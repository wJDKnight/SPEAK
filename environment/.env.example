# Default data location. STARmap is bundled; the complete Figshare package can
# be placed under this directory or selected through the overrides below.
LLM_ST_DATA_ROOT=./examples

# Dataset-specific roots are optional overrides.
LLM_ST_STARMAP_ROOT=./examples/starmap
LLM_ST_STARMAP_TEMPLATE={sample}
LLM_ST_VISIUM_ROOT=./examples/visium_libd
LLM_ST_MERFISH_ROOT=./examples/merfish
LLM_ST_COPD_ROOT=./examples/copd/230267_Slide2
LLM_ST_RESULTS_ROOT=./examples/results
LLM_ST_INTERMEDIATE_ROOT=./examples/intermediates

# Generated batch requests, responses, annotations, and metrics.
LLM_ST_RUN_ROOT=.

# Provider credentials are never committed.
OPENAI_API_KEY=
GOOGLE_API_KEY=
